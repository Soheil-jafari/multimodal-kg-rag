# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit real keys. Code reads secrets ONLY from the environment.

# --- OpenAI (LLM backend) ---
OPENAI_API_KEY=your_key_here
# Optional overrides for an OpenAI-compatible endpoint:
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Neo4j (only needed when backends.graph = neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
